[
  {
    "stepTitle": "采集参数",
    "items": [
      {
        "type": "tips",
        "helpText": "采集周期调小时 BMC 压力增大，请结合带外网络带宽评估。"
      },
      {
        "type": "text",
        "field": "wizard_ipmi_concurrency",
        "label": "IPMI 并发数",
        "initValue": "16",
        "rules": [
          { "required": true, "message": "请输入并发数" },
          { "pattern": "^[0-9]{1,3}$", "message": "仅允许数字" },
          { "min": 1, "max": 256, "message": "建议范围 1-256" }
        ]
      },
      {
        "type": "select",
        "field": "wizard_sensor_interval",
        "label": "传感器采集周期",
        "initValue": "30",
        "options": [
          { "label": "10 秒（高频）", "value": "10" },
          { "label": "30 秒（推荐）", "value": "30" },
          { "label": "60 秒（低频）", "value": "60" },
          { "label": "300 秒（省资源）", "value": "300" }
        ]
      },
      {
        "type": "select",
        "field": "wizard_metric_retention_days",
        "label": "指标保留时长",
        "initValue": "180",
        "options": [
          { "label": "30 天", "value": "30" },
          { "label": "90 天", "value": "90" },
          { "label": "180 天（推荐）", "value": "180" },
          { "label": "365 天", "value": "365" }
        ]
      },
      {
        "type": "select",
        "field": "wizard_log_level",
        "label": "日志级别",
        "initValue": "info",
        "options": [
          { "label": "info", "value": "info" },
          { "label": "debug", "value": "debug" },
          { "label": "warn", "value": "warn" }
        ]
      }
    ]
  },
  {
    "stepTitle": "通知与地域标签",
    "items": [
      {
        "type": "text",
        "field": "wizard_alert_webhook",
        "label": "默认告警 Webhook 地址",
        "initValue": "",
        "rules": [
          { "pattern": "^$|^https?://.+", "message": "请填写 http(s):// 开头的地址或留空" }
        ]
      },
      {
        "type": "switch",
        "field": "wizard_geoip_enable",
        "label": "启用 GeoIP 地域标签",
        "initValue": true
      }
    ]
  }
]
