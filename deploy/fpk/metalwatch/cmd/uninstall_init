#!/bin/bash
# 卸载前：按用户选择处理数据（原生应用，数据全在 TRIM_PKGVAR）
# 铁律：只清理本应用自己的目录，绝不动共享目录中的其它内容与其它应用数据。
set -u

DATA_DIR="${TRIM_PKGVAR}/data"
LOG_DIR="${TRIM_PKGVAR}/logs"
LOG_FILE="${LOG_DIR}/metalwatch.log"
KEEP="${wizard_uninstall_keep_data:-true}"

log_msg() {
  mkdir -p "$LOG_DIR" 2>/dev/null
  echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "$LOG_FILE"
}

# 把体积小、价值高的元数据库备份到共享目录（时序库可能数 GB，不在此处复制）
backup_metadata() {
  share="${TRIM_DATA_SHARE_PATHS%%:*}"
  [ -n "$share" ] && [ -d "$share" ] || return 0

  dest="${share}/metalwatch-backup-$(date +%Y%m%d%H%M%S)"
  mkdir -p "$dest" || return 0

  for f in metalwatch.db metalwatch.db-wal metalwatch.db-shm; do
    [ -f "${DATA_DIR}/${f}" ] && cp -f "${DATA_DIR}/${f}" "${dest}/" 2>/dev/null
  done
  # 配置与日志一并留存，便于事后排查
  [ -f "${TRIM_PKGETC}/metalwatch.yaml" ] && cp -f "${TRIM_PKGETC}/metalwatch.yaml" "${dest}/" 2>/dev/null
  [ -f "${LOG_FILE}" ] && cp -f "${LOG_FILE}" "${dest}/" 2>/dev/null

  log_msg "已备份元数据到 ${dest}"
  echo "已备份 MetalWatch 元数据到：${dest}"
}

case "$KEEP" in
  true|TRUE|1|yes)
    backup_metadata > "$TRIM_TEMP_LOGFILE"
    log_msg "用户选择保留数据，运行数据保持原地（${TRIM_PKGVAR}）"
    ;;
  *)
    backup_metadata >> "$TRIM_TEMP_LOGFILE"
    log_msg "用户选择删除数据，开始清理本应用目录"
    rm -rf "$DATA_DIR" "$LOG_DIR"
    rm -f "${TRIM_PKGVAR}/metalwatch.pid" "${TRIM_PKGVAR}/metalwatch.sock"
    echo "已删除 MetalWatch 运行数据（元数据已备份到共享目录）。" > "$TRIM_TEMP_LOGFILE"
    log_msg "清理完成"
    ;;
esac

exit 0
