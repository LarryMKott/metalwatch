# 编辑器 / IDE
.idea/
.vscode/
*.iml
*.swp

# 构建产物
*.fpk
build/
dist/
deploy/build/
deploy/fpk/*/target/

# Go
backend/bin/
agent/bin/
backend/static/
coverage.out
*.test
*_test.exe

# 前端
node_modules/
.pnpm-store/
.vite/
*.tsbuildinfo

# 本地运行数据
tmp-data/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/

# 运行时数据（应用真实数据由 FPK 落到飞牛 TRIM_PKGVAR，不入库）
data/
logs/
*.log

# 本地/敏感配置
.env
.env.local
.env.*.local
!.env.example
deploy/fpk/metalwatch/app/docker/.env
secrets/
*.pem
*.key

# 系统
.DS_Store
Thumbs.db
desktop.ini

# npm 在受限环境下会写出的字面量环境变量目录（Windows only，必需忽略）
%SystemDrive%/

# 编辑器/工具自动生成的忽略文件（同步自 .gitignore，无需入库）
.zcodeignore
