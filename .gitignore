# 编辑器 / IDE
.idea/
.vscode/
*.iml
*.swp

# 构建产物
*.fpk
build/
# 根目录 dist 锚定 + frontend/dist 显式列出：无锚定的 dist/ 会排除掉
# backend/api/web/webui/dist 目录本身，导致占位 index.html 的再包含规则失效
/dist/
frontend/dist/
deploy/build/
deploy/fpk/*/target/
# 服务端静态二进制（由 deploy/script/build_fpk.py 生成，30MB 级，不入库）
deploy/fpk/*/app/server/metalwatch
deploy/fpk/*/app/server/metalwatch.exe

# Go
backend/bin/
agent/bin/
backend/static/
coverage.out
*.test
*_test.exe

# 前端
node_modules/
.pnpm-store/
.vite/
*.tsbuildinfo

# 本地运行数据
tmp-data/
# CI 起服用的数据目录（ci.yml: --data ./ci-data）：
# 内含 metalwatch.db 与 bootstrap_admin.txt（初始管理员**明文口令**），绝不可入库
ci-data/
# SQLite 运行时库（元数据库 / Agent spool），一律不入库
*.db

# 本地开发产物：编译好的二进制与运行时数据（backend/bin-local、agent/bin-local）
# 内含 Agent 凭据文件（token / credentials.json / host_id.txt）——绝不可入库
bin-local/

# 临时探针的编译产物（源码在 backend/devtools/ 下，正常入库）
# 两条都要：Windows 产物带 .exe，Linux/macOS 产物无扩展名（实测曾漏进 `streamprobe`）
streamprobe.exe
devtools/**/streamprobe

# 无依赖的脚本目录里被误生成的 npm 锁文件
deploy/script/package-lock.json

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/

# 运行时数据（应用真实数据由 FPK 落到飞牛 TRIM_PKGVAR，不入库）
data/
logs/
*.log

# 本地/敏感配置
.env
.env.local
.env.*.local
!.env.example
deploy/fpk/metalwatch/app/docker/.env
secrets/
*.pem
*.key

# 系统
.DS_Store
Thumbs.db
desktop.ini

# npm 在受限环境下会写出的字面量环境变量目录（Windows only，必需忽略）
%SystemDrive%/

# 编辑器/工具自动生成的忽略文件（同步自 .gitignore，无需入库）
.zcodeignore

# Python 测试报告产物
tests/python/reports/

# Release 发布说明：发布时由 deploy/tools/gen_release_notes.py 现场生成，不入库
#（累积历史在 CHANGELOG.md；GitHub 的 --notes-file 直接吃构建期文件，无 Gitee 的入库约束）
RELEASE_NOTES.md

# 前端真实产物（服务端 go:embed 的源，D42）：构建时生成不入库。
# 占位 index.html 除外——它是「没构建前端也能编译/测试」的兜底。
backend/api/web/webui/dist/*
!backend/api/web/webui/dist/index.html
